<launch>

  <arg name="robot_id" default="$(env ROBOT_ID 'unnamed_robot')"/>

  <arg name="invert_tf" default="False"/>



  <node pkg="tf2_ros" exec="static_transform_publisher"
      name="tf_hokuyo_ust10lx"
      args="0.120 0 0.2666 0 0 0 $(var robot_id)/base_link $(var robot_id)/laser"
      unless="$(var invert_tf)"
      namespace="$(var robot_id)"/>

  <node pkg="tf2_ros" exec="static_transform_publisher"
      name="tf_hokuyo_ust10lx"
      args="-0.120 0 -0.2666 0 0 0 $(var robot_id)/laser $(var robot_id)/base_link"
      if="$(var invert_tf)"
      namespace="$(var robot_id)"/>

</launch>
