<launch>

  <!--
    HOW TO RUN THIS LAUNCH FILE:
    $ cd ~/bag_files/     OR      $ cd /media/data/bag_files
    $ roslaunch inesctec_mrdt_hangfa_discovery_q2_nav_conf run_rosbag_play.launch
  filenames:=$(pwd)/log_<name of the log file>.bag
  -->

  <arg name="robot_id" default="$(env ROBOT_ID 'unnamed_robot')" />
  <arg name="robot_conf" default="$(env ROBOT_CONF 'basic')" />

  <arg name="filename" />
  <arg name="rate" default="1.0" />


  <executable cmd="ros2 bag play --rate $(var rate) $(var filename)"
    name="rosbag2_record" output="screen" shell="true" />

</launch>